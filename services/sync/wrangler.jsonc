{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orglet-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "vars": {
    "SYNC_ENABLED": "true",
    "SYNC_ISSUER": "https://accounts.codepawl.com/api/auth",
    "SYNC_AUDIENCE": "https://sync.orglet.codepawl.com",
    "SYNC_MAX_ACCOUNT_BYTES": "33554432",
    "SYNC_MAX_RECORDS": "10000",
    "SYNC_MAX_FILE_BYTES": "26214400",
    "SYNC_MAX_FILE_STORAGE_BYTES": "268435456",
    "SYNC_RATE_REQUESTS": "600",
    "SYNC_RATE_FILES": "60",
    "SYNC_RATE_DEVICES": "10"
  },
  "routes": [{ "pattern": "sync.orglet.codepawl.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "SYNC_FILES", "bucket_name": "orglet-sync-files" }],
  "durable_objects": { "bindings": [{ "name": "SYNC_ACCOUNTS", "class_name": "AccountSync" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountSync"] }],
  "observability": { "enabled": true, "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
