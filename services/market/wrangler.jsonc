{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orglet-market",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  // Production takes submissions and serves approved account listings. MARKET_REVIEWER_SUBJECTS is a Worker secret
  // (wrangler secret put), so the reviewers' account subjects are not in this repository. Without it nobody can
  // review and account listings are not served.
  "vars": { "MARKET_WRITES_ENABLED": "true", "MARKET_PUBLIC_PUBLISHING_ENABLED": "true" },
  "d1_databases": [{
    "binding": "MARKET_DB",
    "database_name": "orglet-market",
    "database_id": "1b98fccd-9fba-4937-af33-6789a188f5e3",
    "migrations_dir": "migrations"
  }],
  "routes": [{ "pattern": "market.orglet.codepawl.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "local_test": {
      "routes": [],
      "vars": { "MARKET_WRITES_ENABLED": "false", "MARKET_PUBLIC_PUBLISHING_ENABLED": "false", "MARKET_REVIEWER_SUBJECTS": "[]" },
      "d1_databases": [{
        "binding": "MARKET_DB",
        "database_name": "orglet-market-local-test",
        "database_id": "00000000-0000-0000-0000-000000000476",
        "migrations_dir": "migrations",
        "remote": false
      }]
    }
  }
}
