{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orglet-market",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "routes": [{ "pattern": "market.orglet.codepawl.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
