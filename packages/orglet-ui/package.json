{
  "name": "@codepawl/orglet-ui",
  "version": "0.0.0",
  "description": "The interface Orglet is built from: a small set of components and the tokens they read",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "CodePawl",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./tokens.css",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "check:stories": "node scripts/check-stories.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "lucide-react": "1.47.0",
    "playwright": "1.63.0",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-axe": "1.0.0-pre.5"
  }
}
