{
  "name": "orglet",
  "productName": "Orglet",
  "version": "0.2.5",
  "description": "A local workspace for AI workers and teams",
  "private": true,
  "main": ".vite/build/main.js",
  "author": "CodePawl",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron-forge start",
    "dev:web": "vite --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:packaged": "node scripts/packaged-checker-smoke.mjs",
    "test:isolation": "node scripts/isolation-smoke.mjs",
    "test:routines": "node scripts/routine-smoke.mjs",
    "test:skills": "node scripts/skill-smoke.mjs",
    "test:run-audit": "node scripts/run-audit-smoke.mjs",
    "test:findings": "node scripts/finding-smoke.mjs",
    "test:revisions": "node scripts/revision-smoke.mjs",
    "test:knowledge": "node scripts/knowledge-smoke.mjs",
    "test:harness": "node scripts/harness-smoke.mjs",
    "test:sidebar": "node scripts/sidebar-smoke.mjs",
    "test:i18n": "node scripts/i18n-smoke.mjs",
    "test:live": "vitest run tests/live/provider-acceptance.test.ts",
    "i18n:keys": "node scripts/i18n-keys.cjs --unused",
    "images:readme": "node scripts/readme-screenshots.mjs",
    "images:social": "electron scripts/social-preview.cjs",
    "images:orglets": "electron scripts/doc-orglets.cjs"
  },
  "config": {
    "forge": "./forge.config.ts"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@duckdb/node-api": "1.5.5-r.5",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "1.46.0",
    "openai": "7.15.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@microsoft/mxc-sdk": "0.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
